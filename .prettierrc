{
    "bracketSpacing": true,
    "parser": "typescript",
    "printWidth": 120,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": true,
    "bracketSameLine": true,
    "overrides": [
        {
            "files": ["*.js", "*.jsx"],
            "options": {
                "parser": "babel",
                "endOfLine": "auto"
            }
        },
        {
            "files": ["*.ts", "*.tsx"],
            "options": {
                "parser": "typescript",
                "endOfLine": "auto"
            }
        }
    ]
}