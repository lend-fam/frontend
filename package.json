    "@marsidev/react-turnstile": "^1.1.0",
    "@rainbow-me/rainbowkit": "^2.2.8",
    "@tanstack/react-query": "^5.83.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@use-glyph/sdk-react": "^1.0.24",
    "classnames": "^2.5.1",
    "graphql": "^16.11.0",
    "posthog-js": "^1.257.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.7.0",
