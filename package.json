{
  "name": "frontend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite --mode develop",
    "dev:prod": "vite --mode prod",
    "build": "tsc -b && vite build --mode prod",
    "build:develop": "tsc -b && vite build --mode develop",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "prettier": "prettier --check './**/*.{js,mjs,cjs,ts,tsx}'",
    "prettier:fix": "prettier --write './**/*.{js,mjs,cjs,ts,tsx}'",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lend-fam/frontend.git"
